<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.0" />
    
    <Reference Include="VipCoreApi">
      <HintPath>3rd_party\VipCoreApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="ChatManagerApi">
      <HintPath>3rd_party\ChatManagerApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
